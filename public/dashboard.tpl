 async history(){V('Loading…');const j=await api('versions');V(`<div class="card"><p>A snapshot is stored on every publish or restore (latest 50 kept). Restoring creates a new published version.</p><div class="row"><button class="b" data-a="hcmp">Compare 2 selected</button></div><table><tr><th></th><th>Version</th><th>When</th><th>Action</th><th>Summary</th><th></th></tr>${j.items.map(v=>`<tr><td><input type="checkbox" style="width:auto" data-a="hsel" data-id="${v.id}" aria-label="Select"></td><td>v${v.version}</td><td>${ago(v.at)}</td><td>${esc(v.action)}</td><td>${esc(v.summary)}</td><td><button class="b" data-a="hview" data-id="${v.id}">Diff vs live</button> <button class="b" data-a="hprev" data-id="${v.id}">Preview</button> <button class="b d" data-a="hrestore" data-id="${v.id}">Restore…</button></td></tr>`).join('')||'<tr><td colspan=6>No snapshots yet. They are recorded from your next publish (after migration 0002).</td></tr>'}</table></div><div id="hd"></div>`)},
 async analytics(){V('Loading…');const j=await api('analytics?days=30');if(!j.configured)return V(`<div class="card dot">${esc(j.note)}</div>`);const R=j.rows;if(!R.length)return V('<div class="card">No analytics collected yet. Events are recorded from visitors to the live site (Do Not Track is respected; no IPs or cookies are stored).</div>');
  const by=(t,key)=>{const m={};R.filter(r=>r.t===t).forEach(r=>m[r[key]]=(m[r[key]]||0)+r.n);return m},sum=t=>Object.values(by(t,'t')).reduce((a,b)=>a+b,0);const views=by('view','day'),inq={};j.inquiryDays.forEach(d=>inq[d]=(inq[d]||0)+1);const st=sum('form_start'),sb=sum('form_submit');
