<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><title>$TENCYL Dashboard</title>
<style>
*{box-sizing:border-box;margin:0}body{background:#080808;color:#fff;font:14px/1.5 system-ui,sans-serif}
[hidden]{display:none!important}
.mono,button,label{font-family:ui-monospace,Menlo,monospace}
#login{max-width:340px;margin:20vh auto;padding:20px;display:grid;gap:12px}
#app{display:grid;grid-template-columns:210px 1fr;min-height:100vh}
aside{border-right:1px solid #222;padding:16px;display:flex;flex-direction:column;gap:4px;position:sticky;top:0;height:100vh}
aside h1{font-size:18px;margin-bottom:14px}aside button{text-align:left;background:none;border:0;color:#999;padding:9px 10px;cursor:pointer;font-size:12px}
aside button.on,aside button:hover{color:#fff;background:#151515}
main{padding:20px;min-width:0}
#bar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;border:1px solid #222;padding:10px;margin-bottom:18px;background:#0e0e0e}
#bar .sp{flex:1}.dot{color:#ffb454}
button.b,a.b{background:#151515;color:#fff;border:1px solid #333;padding:8px 12px;cursor:pointer;font-size:12px;text-decoration:none;display:inline-block}
button.b:hover{border-color:#777}button.p{background:#fff;color:#080808}button.d{color:#ff8a8a}
input,select,textarea{width:100%;background:#0e0e0e;border:1px solid #2a2a2a;color:#fff;padding:8px;font:inherit}
textarea{min-height:70px}label{display:grid;gap:4px;font-size:11px;color:#999;text-transform:uppercase}
label.ck{display:flex;gap:8px;align-items:center}label.ck input{width:auto}
.g{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin-bottom:12px}
.card{border:1px solid #222;background:#0c0c0c;padding:14px;margin-bottom:14px}.card h3{font-size:13px;margin-bottom:10px}
.stat{font-size:28px;font-weight:700}.row{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
#toast{position:fixed;bottom:16px;right:16px;padding:10px 14px;max-width:420px;z-index:9;font-size:13px}#toast.ok{background:#12351f}#toast.bad{background:#4a1616}
#toast:empty{display:none}.pv{display:block;margin:0 auto;border:1px solid #333;background:#fff;height:75vh;max-width:100%}
table{width:100%;border-collapse:collapse}td,th{border-bottom:1px solid #222;padding:8px;text-align:left;font-size:13px}
@media(max-width:760px){#app{grid-template-columns:1fr}aside{position:static;height:auto;flex-direction:row;flex-wrap:wrap}aside h1{width:100%}}
h2{font-size:15px;margin:18px 0 8px}.bar2{display:grid;grid-template-columns:150px 1fr 44px;gap:8px;align-items:center;margin:4px 0;font-size:12px}.bar2 i{display:block;height:8px;background:#fff;opacity:.8}
.badge{border:1px solid #333;padding:1px 6px;font-size:11px;white-space:nowrap}.badge.bad{border-color:#a33;color:#ff8a8a}.badge.ok{border-color:#2a6;color:#7fe0a6}
.split{display:grid;grid-template-columns:1.4fr 1fr;gap:14px}@media(max-width:900px){.split{grid-template-columns:1fr}}</style></head><body>
<form id="login"><h1>$TENCYL</h1><input id="pw" type="password" placeholder="Admin password" autocomplete="current-password" required><button class="b p">Sign in</button><div id="le" style="color:#ff8a8a"></div></form>
<div id="app" hidden><aside><h1>$TENCYL</h1><div id="nav"></div></aside><main><div id="bar"></div><div id="view"></div></main></div><div id="toast" role="status"></div>
<script>
const $=s=>document.querySelector(s),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let csrf='',T={kind:'draft'},cur=null,orig='',tab='overview',pvw='100%',imp=null,rev=0,ls='';
const TABS=[['overview','Overview'],['site','Website Editor'],['projects','Projects'],['services','Services & Process'],['faq','FAQ'],['pricing','Pricing'],['inquiries','Inquiries'],['clients','Client Previews'],['history','Version History'],['analytics','Analytics'],['health','Site Health'],['json','JSON Data'],['settings','Settings']];
const LEAD=['New','Reviewing','Replied','In Progress','Completed','Archived'],CST=['Draft','Ready for Review','Changes Requested','Approved','Archived'];
const dirty=()=>cur&&JSON.stringify(cur)!==orig;
const toast=(m,bad)=>{const t=$('#toast');t.textContent=m;t.className=bad?'bad':'ok';clearTimeout(toast.t);toast.t=setTimeout(()=>t.textContent='',bad?9000:3500)};
async function api(p,m='GET',b){const r=await fetch('/api/admin/'+p,{method:m,headers:{'content-type':'application/json','x-csrf':csrf},body:b?JSON.stringify(b):undefined});const j=await r.json().catch(()=>({}));
 if(!r.ok){if(r.status===401){location.reload()}const e=new Error((j.error||'Request failed')+(j.errors?': '+j.errors.join('; '):''));throw e}return j}
const run=async f=>{try{await f()}catch(e){toast(e.message,1)}};
const get=(o,p)=>p.split('.').reduce((a,k)=>a?.[k],o),set=(o,p,v)=>{const k=p.split('.'),l=k.pop();get(o,k.join('.')||'')?.[l]!==undefined||0;k.reduce((a,x)=>a[x],o)[l]=v};
function F(label,path,t='text'){const v=get(cur,path);const a=`data-p="${path}" data-t="${t}"`;
 if(t==='area'||t==='lines'||t==='csv'){const val=t==='lines'?(v||[]).join('\n'):t==='csv'?(v||[]).join(', '):v;return`<label>${label}<textarea ${a}>${esc(val)}</textarea></label>`}
 if(t==='bool')return`<label class="ck"><input type="checkbox" ${a} ${v?'checked':''}>${label}</label>`;
 return`<label>${label}<input ${a} type="${t==='num'?'number':'text'}" ${t==='num'?'min="250" max="1000" step="1"':''} value="${esc(v)}"></label>`}
function bindInputs(){document.querySelectorAll('#view [data-p]').forEach(i=>i.oninput=()=>{const t=i.dataset.t;let v=i.value;
 if(t==='bool')v=i.checked;else if(t==='num')v=v===''?0:parseInt(v,10);else if(t==='lines')v=v.split('\n').map(x=>x.trim()).filter(Boolean);else if(t==='csv')v=v.split(',').map(x=>x.trim()).filter(Boolean);
 set(cur,i.dataset.p,v);bar()})}
function bar(){const L=T.kind==='draft'?'Public website (draft)':'Client: '+esc(T.meta?.label);
 $('#bar').innerHTML=`<b class="mono">${L}</b>${dirty()?'<span class="dot">● unsaved changes</span>':ls?'<span class="mono" style="color:#999">saved '+ls+'</span>':''}<span class="sp"></span>
 <button class="b p" data-a="save">Save draft</button><button class="b" data-a="reset">Reset changes</button><button class="b" data-a="preview">Preview</button>${T.kind==='client'?'<button class="b" data-a="back">Back to public draft</button>':''}`}
async function load(kind,id){if(dirty()&&!confirm('Discard unsaved changes?'))return;
 if(kind==='draft'){const j=await api('site');cur=j.draft;rev=j.draftUpdated;T={kind:'draft'}}else{const j=await api('clients/'+id);cur=j.config;rev=j.client.updated;T={kind:'client',id,meta:j.client,shares:j.shares,linked:j.linked}}
 orig=JSON.stringify(cur);show(tab==='clients'&&kind==='draft'?'clients':tab==='overview'?'site':tab)}
function show(t){if(t!==tab&&dirty()&&t!=='preview'&&0)return;tab=t;$('#nav').innerHTML=TABS.map(([k,l])=>`<button data-n="${k}" class="${k===t?'on':''}">${l}</button>`).join('')+'<a class="b" style="display:block;margin:6px 0" href="/imghost" target="_blank" rel="noopener">Image host ↗</a><button data-n="logout">Logout</button>';bar();Promise.resolve(VIEWS[t]()).catch(e=>V('<div class="card">'+esc(e.message)+'</div>'))}
const V=h=>{$('#view').innerHTML=h;bindInputs()};
const when=t=>t?new Date(t).toLocaleString():'—';
const VIEWS={
 async overview(){V('Loading…');const s=await api('stats');V(`<div class="g">${[['Published projects',s.published],['Draft projects',s.draftProjects],['Client drafts',s.clients],['Inquiries stored',s.inquiries]].map(([a,b])=>`<div class="card"><div class="stat">${b}</div>${a}</div>`).join('')}</div>
 <div class="card"><h3>Status</h3><p>Live version: v${s.liveVersion} · published ${when(s.liveUpdated)}</p><p>Draft last saved: ${when(s.draftUpdated)} · ${s.draftDiffersFromLive?'<span class="dot">draft differs from live</span>':'draft matches live'}</p><p>Last export: ${when(s.lastExport)}</p></div>
 <div class="row"><button class="b p" data-n="site">Edit website</button><button class="b" data-a="newproj">Create project</button><button class="b" data-a="newclient">Create client preview</button><button class="b" data-a="exp" data-x="live">Export JSON</button></div>`)},
 site(){const n=cur.site.nav.map((x,i)=>`<div class="g">${F('Nav label','site.nav.'+i+'.label')}${F('Link','site.nav.'+i+'.href')}${F('Visible','site.nav.'+i+'.visible','bool')}</div>`).join('');
  V(`<div class="card"><h3>Global</h3><div class="g">${F('Brand','site.brand')}${F('Tagline','site.tagline')}${F('Footer text','site.footer')}</div></div>
  <div class="card"><h3>Navigation</h3>${n}</div>
  <div class="card"><h3>Hero</h3><div class="g">${F('Eyebrow','site.hero.eyebrow')}${F('Headline','site.hero.headline')}${F('Subheading','site.hero.sub')}${F('CTA 1 label','site.hero.cta1')}${F('CTA 2 label','site.hero.cta2')}</div>${F('Paragraph','site.hero.text','area')}</div>
  <div class="card"><h3>About</h3>${F('Title','site.about.title')}${F('Description','site.about.text','area')}</div>
  <div class="card"><h3>Contact</h3>${F('Heading','site.contact.title')}${F('Description','site.contact.text','area')}${F('Feature choices (one per line)','site.contact.features','lines')}</div>
  <div class="card"><h3>SEO</h3>${F('SEO title','site.seo.title')}${F('Meta description','site.seo.description','area')}</div>`)},
 projects(){V(`<div class="row"><button class="b p" data-a="newproj">+ New project</button></div>`+cur.projects.map((p,i)=>`<div class="card"><h3>${esc(p.name)||'Untitled'} <span class="mono">#${i+1}</span></h3>
  <div class="g">${F('Name',`projects.${i}.name`)}${F('Window filename',`projects.${i}.filename`)}${F('Status',`projects.${i}.status`)}${F('Category',`projects.${i}.category`)}${F('Date',`projects.${i}.date`)}${F('Thumbnail URL',`projects.${i}.thumb`)}${F('Live URL',`projects.${i}.liveUrl`)}${F('Preview URL',`projects.${i}.previewUrl`)}${F('GitHub URL',`projects.${i}.githubUrl`)}</div>
  ${F('Description',`projects.${i}.description`,'area')}${F('Technology tags (comma separated)',`projects.${i}.tech`,'csv')}
  ${p.thumb?`<img alt="" src="${esc(p.thumb)}" style="width:160px;aspect-ratio:16/9;object-fit:cover;margin:8px 0" referrerpolicy="no-referrer">`:''}
  <div class="row">${F('Public',`projects.${i}.visible`,'bool')}${F('Featured',`projects.${i}.featured`,'bool')}<button class="b" data-a="mv" data-k="projects" data-i="${i}" data-d="-1">↑</button><button class="b" data-a="mv" data-k="projects" data-i="${i}" data-d="1">↓</button><button class="b" data-a="dup" data-k="projects" data-i="${i}">Duplicate</button><button class="b d" data-a="del" data-k="projects" data-i="${i}">Delete</button></div></div>`).join(''))},
 pricing(){V(`<p class="mono" style="color:#999;margin-bottom:12px">Prices must be whole numbers from ₹250 to ₹1,000 — enforced here and on the server.</p><div class="row"><button class="b p" data-a="newtier">+ New tier</button></div>`+cur.pricing.map((t,i)=>`<div class="card"><h3>${esc(t.name)} <span class="mono">#${i+1}</span></h3>
  <div class="g">${F('Tier name',`pricing.${i}.name`)}${F('Price (₹)',`pricing.${i}.price`,'num')}${F('CTA text',`pricing.${i}.cta`)}</div>${F('Features (one per line)',`pricing.${i}.features`,'lines')}
  <div class="row">${F('Visible',`pricing.${i}.visible`,'bool')}<button class="b" data-a="mv" data-k="pricing" data-i="${i}" data-d="-1">↑</button><button class="b" data-a="mv" data-k="pricing" data-i="${i}" data-d="1">↓</button><button class="b d" data-a="del" data-k="pricing" data-i="${i}">Delete</button></div></div>`).join(''))},
 async clients(){V('Loading…');const j=await api('clients');V(`<div class="card"><h3>New client draft</h3><div class="g"><label>Client label<input id="nl"></label><label>Start from<select id="nf"><option value="live">Current live site</option>${j.items.map(c=>`<option value="${c.id}">${esc(c.label)}</option>`).join('')}</select></label></div><button class="b p" data-a="mkclient">Create</button></div>
  <div class="card"><table><tr><th>Client</th><th>Status</th><th>Updated</th><th></th></tr>${j.items.map(c=>`<tr><td>${esc(c.label)}</td><td>${esc(c.status)}</td><td>${when(c.updated)}</td><td><button class="b" data-a="open" data-id="${c.id}">Edit</button> <button class="b" data-a="cdup" data-id="${c.id}">Duplicate</button> <button class="b" data-a="exp" data-x="client/${c.id}">Export</button> <button class="b d" data-a="cdel" data-id="${c.id}">Delete</button></td></tr>`).join('')||'<tr><td colspan=4>No client drafts yet.</td></tr>'}</table></div>`)},
 preview(){const u=T.kind==='draft'?'/preview/draft':'/preview/client/'+T.id;V(`<div class="row" style="margin:0 0 10px"><button class="b" data-a="w" data-w="100%">Desktop</button><button class="b" data-a="w" data-w="820px">Tablet</button><button class="b" data-a="w" data-w="390px">Mobile</button><button class="b" data-a="refresh">Refresh</button><button class="b" data-n="site">Return to editor</button></div>
  ${dirty()?'<p class="dot">Unsaved edits are not shown — save the draft, then refresh.</p>':''}<iframe id="pf" class="pv" style="width:${pvw}" src="${u}"></iframe>`)},
 json(){V(`<div class="card"><h3>Export (validated before download)</h3><div class="row"><button class="b" data-a="exp" data-x="live">Public (live)</button><button class="b" data-a="exp" data-x="draft">Public draft</button><button class="b" data-a="exp" data-x="bundle">Full content bundle</button><button class="b" data-a="exp" data-x="backup">Backup incl. inquiries</button></div><p style="color:#999;margin-top:8px">Exports never contain secrets. Only “backup” includes inquiry data.</p></div>
  <div class="card"><h3>Import</h3><input id="if" type="file" accept="application/json,.json"><div class="g" style="margin-top:10px"><label>Apply to<select id="it"><option value="draft">Public draft</option><option value="client-new">New client draft</option></select></label><label>Client label (if new)<input id="il"></label></div><div id="is"></div></div>`)},
 settings(){V(`<div class="card"><h3>Publish</h3><p>Publishing copies the saved <b>public draft</b> to the live site. Saving or previewing never does.</p><div class="row"><button class="b p" data-a="publish">Publish draft to live…</button></div><p class="mono" style="color:#999;margin-top:8px">Publish updates what the Worker serves from D1. It does not change Git files or trigger a build.</p></div>
  ${T.kind==='client'?`<div class="card"><h3>Client: ${esc(T.meta.label)}</h3><div class="g"><label>Label<input id="cl" value="${esc(T.meta.label)}"></label><label>Status<select id="cs">${CST.map(s=>`<option ${s===T.meta.status?'selected':''}>${s}</option>`).join('')}</select></label></div><label>Notes<textarea id="cn">${esc(T.meta.notes)}</textarea></label><div class="row"><button class="b" data-a="cmeta">Save details</button></div>
  ${(T.linked||[]).length?'<p>Linked inquiries: '+T.linked.map(l=>esc(l.ref+' '+l.name)).join(', ')+'</p>':''}<h3 style="margin-top:14px">Private review link</h3><div class="row"><input id="sh" type="number" value="72" min="1" max="720" style="width:90px"><button class="b" data-a="share">Create link (hours)</button></div><div id="sl" class="mono"></div>
  ${(T.shares||[]).map(s=>`<p>Link ${s.id.slice(0,8)} · expires ${when(s.expires)} ${s.revoked?'(revoked)':`<button class="b d" data-a="revoke" data-id="${s.id}">Revoke</button>`}</p>`).join('')}</div>`:''}`)}
};

let PQ='',CQ='',CS='',CLI=[],IF={},INQ={items:[],sel:{},cur:null,clients:[]},HS={};
const ago=t=>t?new Date(t).toLocaleString():'—',bdg=(v)=>`<span class="badge ${v==='sent'?'ok':v==='failed'?'bad':''}">${esc(v)}</span>`;
const bars=(m,n=8)=>{const e=Object.entries(m).sort((a,b)=>b[1]-a[1]).slice(0,n),mx=Math.max(1,...e.map(x=>x[1]));return e.length?e.map(([k,v])=>`<div class="bar2"><span>${esc(k||'(none)')}</span><i style="width:${v/mx*100}%"></i><b>${v}</b></div>`).join(''):'<p style="color:#777">No data yet.</p>'};
const STARTER={services:[['Minimalist websites','Clean, focused sites with precise typography and negative space.',['Minimalist styling','Responsive layout']],['Business websites','A clear online home for your business.',['Responsive layout','Contact form']],['Landing pages','Single-page sites built around one goal.',['Responsive layout','Essential interactions']],['Portfolio websites','Show your work with a polished, personal site.',['Project galleries','Responsive layout']],['Glassmorphism & GlassUI','Frosted-glass interfaces with depth.',['GlassUI surfaces','Smooth transitions']],['Interactive 3D websites','Real-time 3D scenes that respond to the visitor.',['3D elements','Pointer interaction']],['Animation-rich websites','Considered motion that supports the design.',['Scroll and hover effects','Reduced-motion support']],['Responsive redesigns','Bring an existing website up to date on every screen size.',['Mobile-first layout','Modern styling']]],
 process:[['Tell us your idea','Share what you want to build using the project form.'],['Discuss the requirements','We talk through features, style and scope.'],['Design and build','The website is designed and built to the agreed plan.'],['Review the result','You review it and share feedback.'],['Deliver the website','The finished website is delivered.']],
 faq:[['What does a website cost?','Prices are fixed within ₹250–₹1,000 depending on the tier: Basic ₹250, Standard ₹500, Premium ₹1,000.'],['What kinds of websites do you build?','Business websites, landing pages, portfolios, personal websites, interactive GlassUI websites and 3D websites.'],['How do I request a website?','Fill in the project form on this page with your idea and requirements.'],['Can I request glassmorphism or 3D effects?','Yes — they are available in the higher tiers where they suit your project.'],['Will my website work on mobile?','Every tier includes a responsive layout.'],['Can I request changes?','You can share feedback during the review step. The scope of changes is agreed per project.'],['How do I share my project requirements?','Use the inquiry form: describe your idea, choose features and add any reference websites.']]};
const H={
 newclient(){show('clients')},
 newsvc(){cur.services.push({title:'New service',description:'',features:[],projects:[],visible:false,order:cur.services.length+1});show('services')},
 newstep(){if(cur.process.length>=8)return toast('Max 8 steps',1);cur.process.push({title:'New step',text:'',visible:false,order:cur.process.length+1});show('services')},
 newfaq(){cur.faq.push({q:'New question',a:'',visible:false,order:cur.faq.length+1});show('faq')},
 newnav(){cur.site.nav.push({label:'New',href:'#',visible:true});show('site')},
 delnav(d){cur.site.nav.splice(+d.i,1);show('site')},
 starter(){if((cur.services.length||cur.process.length||cur.faq.length)&&!confirm('Add starter items alongside the existing ones?'))return;
  STARTER.services.forEach(x=>cur.services.push({title:x[0],description:x[1],features:x[2],projects:[],visible:true,order:cur.services.length+1}));STARTER.process.forEach(x=>cur.process.push({title:x[0],text:x[1],visible:true,order:cur.process.length+1}));STARTER.faq.forEach(x=>cur.faq.push({q:x[0],a:x[1],visible:true,order:cur.faq.length+1}));toast('Starter content added to the draft — review, save, then publish.');show(tab)},
 projbulk(d){cur.projects.forEach(p=>{if(!PQ||p.name.toLowerCase().includes(PQ))p.visible=d.v==='1'});show('projects')},
 // ---- inquiries
 async iload(){const p=new URLSearchParams();for(const k of['q','status','type','budget'])if(IF[k])p.set(k,IF[k]);if(IF.from)p.set('from',new Date(IF.from).getTime());p.set('sort',IF.sort||'new');INQ.items=(await api('inquiries?'+p)).items;irender()},
 isel(d,el){el.checked?INQ.sel[d.id]=1:delete INQ.sel[d.id]},
 iopen(d){INQ.cur=INQ.items.find(x=>x.id===d.id);irender()},
 async isave(){const i=INQ.cur;await api('inquiries/'+i.id,'PATCH',{status:$('#ist').value,tags:$('#itg').value.split(',').map(x=>x.trim()).filter(Boolean),notes:$('#inn').value,clientId:$('#icl').value||null});toast('Saved');await H.iload();INQ.cur=INQ.items.find(x=>x.id===i.id);irender()},
 async icopyemail(){await navigator.clipboard.writeText(INQ.cur.email);toast('Email copied')},
 async icopy(){const i=INQ.cur;await navigator.clipboard.writeText(`[${i.ref}] ${i.name} <${i.email}>\nBusiness: ${i.business}\nType: ${i.type}\nBudget: ${i.budget}\nDeadline: ${i.deadline}\nURL: ${i.url}\nFeatures: ${(i.features||[]).join(', ')}\n\n${i.desc}\n\nNotes: ${i.notes}`);toast('Details copied')},
 async iretry(){const r=await api('inquiries/'+INQ.cur.id+'/retry','POST');toast('Retry: '+JSON.stringify(r.result));const id=INQ.cur.id;await H.iload();INQ.cur=INQ.items.find(x=>x.id===id);irender()},
 async idel(){if(!confirm('Permanently delete this inquiry? This cannot be undone.'))return;await api('inquiries/'+INQ.cur.id+'?confirm=yes','DELETE');INQ.cur=null;toast('Deleted');await H.iload()},
 async iexp(d){const ids=Object.keys(INQ.sel).length?Object.keys(INQ.sel):INQ.items.map(x=>x.id);const r=await fetch(`/api/admin/inquiries/export?format=${d.f}&ids=${ids.join(',')}&notes=${$('#xn').checked?1:0}`);if(!r.ok)throw new Error((await r.json()).error);const n=(r.headers.get('content-disposition')||'').match(/filename="([^"]+)"/);const a=document.createElement('a');a.href=URL.createObjectURL(await r.blob());a.download=n?n[1]:'inquiries.'+d.f;a.click()},
 // ---- clients
 async carch(d){const c=CLI.find(x=>x.id===d.id);await api('clients/'+d.id,'PATCH',{status:c.status==='Archived'?'Draft':'Archived'});show('clients')},
 // ---- history
 hsel(d,el){el.checked?HS[d.id]=1:delete HS[d.id]},
 async hview(d){const j=await api(`versions/diff?a=${d.id}&b=0`);hdiff(`Version vs current live`,j.changes)},
 async hcmp(){const k=Object.keys(HS);if(k.length!==2)return toast('Select exactly two versions',1);const j=await api(`versions/diff?a=${k[0]}&b=${k[1]}`);hdiff('Comparison',j.changes)},
 hprev(d){window.open('/preview/version/'+d.id,'_blank','noopener')},
