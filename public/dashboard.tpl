const blank={name:'New project',filename:'project_new.exe',status:'Beta',category:'',date:'',description:'',tech:[],thumb:'',liveUrl:'',previewUrl:'',githubUrl:'',visible:false,featured:false};
function dl(name,text){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([text],{type:'application/json'}));a.download=name;a.click()}
async function exportJ(x){const r=await fetch('/api/admin/export/'+x);const t=await r.text();if(!r.ok)throw new Error(JSON.parse(t).error||'Export failed');JSON.parse(t);const n=(r.headers.get('content-disposition')||'').match(/filename="([^"]+)"/);dl(n?n[1]:'stencyl.json',t);toast('Exported')}
document.addEventListener('click',e=>{const el=e.target.closest('[data-a],[data-n]');if(!el)return;const d=el.dataset;run(async()=>{
 if(d.n){if(d.n==='logout'){await fetch('/api/logout',{method:'POST',headers:{'x-csrf':csrf}});return location.reload()}if(d.n==='clients'&&T.kind==='client'&&dirty()&&!confirm('Discard unsaved changes?'))return;if(d.n==='clients'){}show(d.n);return}
 const a=d.a,i=+d.i,k=d.k;
 if(a==='save'){const r=await api(T.kind==='draft'?'site':'clients/'+T.id,'PUT',{config:cur,baseUpdated:rev});cur=r.config;rev=r.updated;orig=JSON.stringify(cur);ls=new Date().toLocaleTimeString();toast('Saved');show(tab)}
 else if(a==='reset'){cur=JSON.parse(orig);show(tab)}
 else if(a==='preview')show('preview');else if(a==='refresh')show('preview');else if(a==='w'){pvw=d.w;show('preview')}
 else if(a==='back')load('draft');
 else if(a==='newproj'){cur.projects.push({...blank,tech:[],order:cur.projects.length+1});show('projects')}
 else if(a==='newtier'){if(cur.pricing.length>=6)return toast('Max 6 tiers',1);cur.pricing.push({name:'New tier',price:250,cta:'Get started',features:[],visible:false,order:cur.pricing.length+1});show('pricing')}
 else if(a==='mv'){const l=cur[k],j=i+ +d.d;if(j<0||j>=l.length)return;[l[i],l[j]]=[l[j],l[i]];l.forEach((x,n)=>x.order=n+1);show(k)}
 else if(a==='dup'){const c=structuredClone(cur[k][i]);if(c.name)c.name+=' copy';else if(c.title)c.title+=' copy';else c.q+=' copy';c.visible=false;cur[k].splice(i+1,0,c);cur[k].forEach((x,n)=>x.order=n+1);show(k)}
 else if(a==='del'){if(confirm('Delete "'+(cur[k][i].name||cur[k][i].title||cur[k][i].q)+'"? Save to make it permanent.')){cur[k].splice(i,1);show(k)}}
 else if(a==='publish'){if(dirty())return toast('Save the draft first.',1);if(!confirm('Publish the saved draft to the LIVE website?'))return;const r=await api('publish','POST',{confirm:true});toast(r.note)}
 else if(a==='exp')await exportJ(d.x);
 else if(a==='mkclient'){const label=$('#nl').value.trim();if(!label)return toast('Enter a client label',1);const r=await api('clients','POST',{label,from:$('#nf').value});await load('client',r.id);show('site')}
 else if(a==='open'){await load('client',d.id);show('site')}
 else if(a==='cdup'){await api('clients/'+d.id+'/duplicate','POST');show('clients')}
 else if(a==='cdel'){if(confirm('Delete this client draft permanently?')){await api('clients/'+d.id,'DELETE');if(T.id===d.id){T={kind:'draft'};await load('draft')}show('clients')}}
 else if(a==='cmeta'){await api('clients/'+T.id,'PATCH',{label:$('#cl').value,status:$('#cs').value,notes:$('#cn').value});const j=await api('clients/'+T.id);T.meta=j.client;T.shares=j.shares;toast('Saved');show('settings')}
 else if(a==='share'){const r=await api('clients/'+T.id+'/share','POST',{hours:+$('#sh').value});$('#sl').innerHTML=`<p>${esc(r.url)}</p><p>${r.note}</p>`}
 else if(a==='revoke'){await api('clients/'+T.id+'/revoke','POST',{shareId:d.id});const j=await api('clients/'+T.id);T.shares=j.shares;show('settings')}
 else if(H[a])await H[a](d,el)
 else if(a==='doimport'){const r=await api('import','POST',{data:imp,target:$('#it').value,label:$('#il').value,dryRun:false,confirm:true});toast('Import applied');imp=null;await load('draft');show('json')}
})});
