 async inquiries(){V('Loading…');INQ.clients=(await api('clients')).items;V(`<div class="card"><div class="g"><input data-f="if" data-k="q" placeholder="Search name, email, text" value="${esc(IF.q||'')}"><select data-f="if" data-k="status"><option value="">All statuses</option>${LEAD.map(s=>`<option ${IF.status===s?'selected':''}>${s}</option>`).join('')}</select><select data-f="if" data-k="type"><option value="">All types</option>${['Business website','Landing page','Portfolio','Personal website','Interactive / GlassUI website','3D website','Other'].map(s=>`<option ${IF.type===s?'selected':''}>${s}</option>`).join('')}</select><select data-f="if" data-k="budget"><option value="">All budgets</option>${['₹250','₹500','₹1,000'].map(s=>`<option ${IF.budget===s?'selected':''}>${s}</option>`).join('')}</select><label>Since<input type="date" data-f="if" data-k="from" value="${esc(IF.from||'')}"></label><select data-f="if" data-k="sort"><option value="new">Newest first</option><option value="old" ${IF.sort==='old'?'selected':''}>Oldest first</option></select></div>
