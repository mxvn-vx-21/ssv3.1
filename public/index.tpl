form{border:1px solid var(--line);background:var(--glass);backdrop-filter:blur(12px);padding:24px;display:grid;grid-template-columns:1fr 1fr;gap:16px}
.f{display:grid;gap:6px}.f.w{grid-column:1/-1}label{color:var(--mut);font-size:10px}
input,select,textarea{background:transparent;border:1px solid var(--line);color:var(--fg);padding:11px;font:inherit;font-size:14px;width:100%}
select option{color:#080808}fieldset{border:0;display:flex;flex-wrap:wrap;gap:8px 16px}fieldset label{display:flex;gap:6px;align-items:center;width:auto}fieldset input{width:auto}
.err{color:#ff8a8a;font-size:12px;min-height:14px}#st{grid-column:1/-1;font-size:13px}
