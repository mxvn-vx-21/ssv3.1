<style>
:root{color-scheme:dark;--bg:#080808;--s1:#0d0d0d;--s2:#131313;--s3:#1a1a1a;--g4:#262626;--g5:#3a3a3a;--g6:#5c5c5c;--g7:#8d8d8d;--g8:#bdbdbd;--fg:#fff;--mut:#8d8d8d;--line:rgba(255,255,255,.13);--glass:rgba(255,255,255,.05);--inv:#fff;--invfg:#080808;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box;margin:0}html{scroll-behavior:smooth;scroll-padding-top:70px}
