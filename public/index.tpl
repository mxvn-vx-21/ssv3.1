.body{padding:18px;display:flex;flex-direction:column;gap:12px;flex:1}.meta{color:var(--mut);font-size:11px}
.tags{display:flex;flex-wrap:wrap;gap:6px}.tag{border:1px solid var(--line);padding:3px 8px;font-size:10px}
.acts{margin-top:auto;display:flex;gap:10px;flex-wrap:wrap}.acts .btn{padding:9px 14px}
.price{font-size:44px;font-weight:700;margin:8px 0 14px}.tier ul{list-style:none;padding:0;display:grid;gap:8px;color:var(--mut)}.tier li::before{content:"✓ ";color:var(--fg)}
