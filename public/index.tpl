.js [data-st]{opacity:0}.ready [data-st]{animation:up .85s var(--e) both;animation-delay:calc(var(--st)*100ms + 800ms)}
@keyframes up{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}
.js #stage{opacity:0;transition:opacity 1.3s ease .5s}.ready #stage{opacity:1}
.js [data-rv]{opacity:0;transition:opacity .8s var(--e),transform .9s var(--e),clip-path 1s var(--e);transition-delay:calc(var(--d,0)*90ms)}
[data-rv=up]{transform:translateY(26px)}[data-rv=scale]{transform:scale(.95)}[data-rv=left]{transform:translateX(-28px)}[data-rv=clip]{clip-path:inset(0 0 92% 0)}
.js [data-rv].in{opacity:1;transform:none;clip-path:inset(-60px)}
@keyframes heroOut{to{transform:translateY(70px) scale(.95);opacity:.3}}@keyframes textOut{to{transform:translateY(-26px);opacity:.45}}
@supports (animation-timeline:view()){.hero>div:first-child{animation:textOut linear both;animation-timeline:view();animation-range:exit 10% exit 85%}#stage{animation:heroOut linear both;animation-timeline:view();animation-range:exit 0% exit 85%}}
html.tchg *,html.tchg *::before,html.tchg *::after{transition:background-color .35s,color .35s,border-color .35s,fill .35s,stroke .35s!important}
/* command palette */
dialog#cp{margin:12vh auto 0;max-width:620px;width:92vw;padding:0;overflow:hidden;background:linear-gradient(160deg,rgba(255,255,255,.1),rgba(255,255,255,.03)),var(--s2);-webkit-backdrop-filter:blur(20px) saturate(140%);backdrop-filter:blur(20px) saturate(140%);box-shadow:0 30px 80px rgba(0,0,0,.6),inset 0 1px 0 rgba(255,255,255,.2);animation:cpin .22s var(--e)}
