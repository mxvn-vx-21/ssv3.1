body::before{content:"";position:fixed;inset:0;background:radial-gradient(900px 600px at 80% 8%,rgba(255,255,255,.07),transparent 60%),radial-gradient(700px 500px at 5% 60%,rgba(140,160,200,.06),transparent 60%),var(--bg);opacity:.95;z-index:-1}
.m,.tag,label,.nav a,.btn{font-family:'JetBrains Mono',ui-monospace,monospace;font-size:12px;letter-spacing:.08em;text-transform:uppercase}
.wrap{max-width:1200px;margin:0 auto;padding:0 20px}
