.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:20px}
.win{border:1px solid var(--line);background:var(--glass);backdrop-filter:blur(12px);display:flex;flex-direction:column;transition:transform .3s}.win:hover{transform:translateY(-4px)}
.bar{display:flex;gap:8px;align-items:center;padding:12px 16px;border-bottom:1px solid var(--line);color:var(--mut)}
.bar i{width:9px;height:9px;border-radius:50%;border:1px solid var(--line)}.bar span{margin-left:6px}
.thumb{aspect-ratio:16/9;height:auto;display:grid;place-items:center;font-weight:700;font-size:26px;border-bottom:1px solid var(--line);background:radial-gradient(circle at 70% 120%,rgba(155,184,255,.22),transparent 60%);overflow:hidden}
