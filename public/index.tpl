.rv{opacity:0;transform:translateY(18px);transition:opacity .7s,transform .7s}.rv.on{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none}html{scroll-behavior:auto}*{animation:none!important}}
@media (max-width:820px){.hero{grid-template-columns:1fr}form{grid-template-columns:1fr}.hide-m{display:none}}

.btn,.tag,input,select,textarea,.chip,.win,form,.tile,header{-webkit-backdrop-filter:blur(16px) saturate(140%)}
.win,.tile,form{background:linear-gradient(145deg,rgba(255,255,255,.10),rgba(255,255,255,.025) 55%,rgba(255,255,255,.05));backdrop-filter:blur(18px) saturate(140%);box-shadow:inset 0 1px 0 rgba(255,255,255,.22),inset 0 0 0 1px rgba(255,255,255,.03),0 18px 50px rgba(0,0,0,.55);border-color:rgba(255,255,255,.16);border-radius:6px}
.win:hover{box-shadow:inset 0 1px 0 rgba(255,255,255,.3),0 24px 60px rgba(0,0,0,.65),0 0 40px rgba(255,255,255,.06)}
header{background:linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.02));box-shadow:inset 0 -1px 0 rgba(255,255,255,.06)}
.btn{background:linear-gradient(180deg,rgba(255,255,255,.12),rgba(255,255,255,.03));box-shadow:inset 0 1px 0 rgba(255,255,255,.25);border-radius:4px}
.btn.p{background:linear-gradient(180deg,#fff,var(--g8));box-shadow:0 0 28px rgba(255,255,255,.25),inset 0 1px 0 #fff}
.tag{background:rgba(255,255,255,.05);border-radius:3px}
input,select,textarea{background:rgba(0,0,0,.35);box-shadow:inset 0 1px 6px rgba(0,0,0,.5);border-radius:4px}
.thumb{background:radial-gradient(circle at 70% 120%,rgba(255,255,255,.14),transparent 60%),linear-gradient(135deg,var(--g4),var(--s1))}
.chip{position:absolute;padding:10px 14px;border:1px solid var(--line);background:linear-gradient(145deg,rgba(255,255,255,.12),rgba(255,255,255,.03));backdrop-filter:blur(14px);box-shadow:inset 0 1px 0 rgba(255,255,255,.25);font:11px 'JetBrains Mono',monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--g8);border-radius:4px;pointer-events:none}
.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-top:34px}.tile{padding:22px;display:grid;gap:8px}.tile b{font-size:18px}.tile span{color:var(--mut);font-size:14px}
#work{background:linear-gradient(180deg,var(--s1),var(--s2))}#pricing{background:linear-gradient(180deg,var(--s2),var(--s3))}#about{background:linear-gradient(180deg,var(--s3),var(--s1))}#contact{background:linear-gradient(180deg,var(--s1),#050505)}
footer{background:#050505}.eyebrow,.meta{color:var(--g7)}.lead,.note{color:var(--g7)}

[hidden]{display:none!important}
:root[data-theme="light"]{color-scheme:light;--bg:#EDEDED;--s1:#e6e6e6;--s2:#dedede;--s3:#d4d4d4;--g7:#555;--g8:#333;--fg:#080808;--mut:#555;--line:rgba(8,8,8,.18);--glass:rgba(255,255,255,.6);--inv:#080808;--invfg:#fff}
:root[data-theme="light"] body::before{background:radial-gradient(900px 600px at 80% 8%,rgba(255,255,255,.8),transparent 60%),var(--bg)}
:root[data-theme="light"] .win,:root[data-theme="light"] .tile,:root[data-theme="light"] form,:root[data-theme="light"] .chip,:root[data-theme="light"] .btn{background:rgba(255,255,255,.6);box-shadow:inset 0 1px 0 #fff,0 10px 30px rgba(0,0,0,.08)}
:root[data-theme="light"] .btn.p{background:var(--inv);color:var(--invfg);box-shadow:none}
:root[data-theme="light"] input,:root[data-theme="light"] select,:root[data-theme="light"] textarea{background:rgba(255,255,255,.7);box-shadow:none}
:root[data-theme="light"] #contact{background:linear-gradient(180deg,var(--s1),var(--s3))}:root[data-theme="light"] footer{background:var(--s3)}
:root[data-theme="light"] header{background:rgba(255,255,255,.55)}:root[data-theme="light"] dialog{background:var(--bg)}
#tt,#mb,#top{width:40px;padding:10px;justify-content:center}#mb{display:none}
#prog{position:absolute;left:0;bottom:-1px;height:2px;background:var(--fg);width:0}header{position:sticky}
#top{position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));z-index:30}
#ld{position:fixed;inset:0;z-index:200;background:var(--bg);display:grid;place-items:center;transition:opacity .5s}#ld.gone{opacity:0;pointer-events:none}
#off{position:fixed;top:70px;left:50%;transform:translateX(-50%);z-index:60;padding:8px 14px;border:1px solid var(--line);background:var(--s2);font:12px 'JetBrains Mono',monospace}
.nav a{padding:4px 0;border-bottom:1px solid transparent}.nav a.on{color:var(--fg);border-color:var(--fg)}.mcta{display:none}
.avl{display:inline-flex;align-items:center;gap:8px;margin-left:14px;padding:3px 10px;border:1px solid var(--line);font:11px 'JetBrains Mono',monospace;letter-spacing:.08em;text-transform:uppercase}.avl::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--fg);animation:pl 2s infinite}
@keyframes pl{50%{opacity:.25}}@keyframes sh{to{background-position:-200% 0}}@keyframes fi{from{opacity:0;transform:translateY(10px)}}
h1.big{background:linear-gradient(100deg,var(--fg) 35%,var(--g6) 50%,var(--fg) 65%);background-size:200% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:sh 7s linear infinite}
#ptools{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:22px}#ptools input{max-width:200px}#ptools select{max-width:160px}.chipb.on{background:var(--inv);color:var(--invfg)}
.empty{padding:40px;text-align:center;color:var(--mut);border:1px dashed var(--line)}
.badge{border:1px solid var(--line);padding:2px 8px;font:10px 'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.08em;display:inline-block}.badge.f{background:var(--inv);color:var(--invfg)}
dialog{background:var(--s2);color:var(--fg);border:1px solid var(--line);max-width:640px;width:92vw;padding:24px;border-radius:6px}dialog::backdrop{background:rgba(0,0,0,.7);backdrop-filter:blur(4px)}dialog h3{font-size:28px;margin:10px 0}
.det{white-space:pre-wrap;color:var(--g7);margin:14px 0}
.tl{list-style:none;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px}.tl li{padding:20px;border:1px solid var(--line);background:var(--glass);cursor:pointer;border-radius:6px;transition:border-color .3s,transform .3s;display:grid;gap:6px}.tl li.act{border-color:var(--fg);transform:translateY(-3px)}.tl li:focus-visible{outline:2px solid #9bb8ff}.tl .n{font:12px 'JetBrains Mono',monospace;color:var(--g7)}.tl p{color:var(--g7);font-size:14px}
.fqi{margin-bottom:12px}.fqb{width:100%;text-align:left;background:none;border:0;color:var(--fg);padding:16px 18px;font:500 16px 'Space Grotesk',sans-serif;cursor:pointer;display:flex;justify-content:space-between;gap:12px}.fqb::after{content:"+"}.fqb[aria-expanded=true]::after{content:"−"}
.fqp{display:grid;grid-template-rows:0fr;transition:grid-template-rows .3s}.fqp.open{grid-template-rows:1fr}.fqp>div{overflow:hidden}.fqp p{padding:0 18px 16px;color:var(--g7)}
.est{padding:24px;margin-top:28px;display:grid;gap:14px}.g2{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px}.est label.ck{display:flex;gap:8px;align-items:center}.est label.ck input{width:auto}#er{min-height:22px;color:var(--fg)}
@media (max-width:820px){#mb{display:inline-flex}.nav{display:flex;position:absolute;top:60px;left:0;right:0;flex-direction:column;gap:14px;padding:18px 20px;background:var(--bg);border-bottom:1px solid var(--line);visibility:hidden;opacity:0;transform:translateY(-8px);transition:opacity .25s,transform .25s,visibility .25s}.nav.open{visibility:visible;opacity:1;transform:none}.mcta{display:block;color:var(--fg)!important}}
@media (prefers-reduced-motion:reduce){#ld,.nav,.fqp,h1.big,.avl::before,#proj .win{transition:none!important;animation:none!important}h1.big{color:var(--fg);background:none}}

/* ===== V3 ===== */
html{scrollbar-gutter:stable}.hero{padding-left:20px;padding-right:20px}.js{--e:cubic-bezier(.2,.7,.1,1)}
html.tn-cur,html.tn-cur *{cursor:none!important}html.tn-cur select,html.tn-cur select *,html.tn-cur input[type=date]{cursor:auto!important}
#cx{position:fixed;inset:auto;left:0;top:0;width:0;height:0;margin:0;padding:0;border:0;background:none;overflow:visible;pointer-events:none;z-index:2147483647;opacity:0;transition:opacity .15s;color:#fff}
#cx.on{opacity:1}#cx[data-s=off]{opacity:0}
#cx svg{position:absolute;left:-13px;top:-13px;width:26px;height:26px;overflow:visible;display:none;fill:none;stroke:#fff;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;pointer-events:none;filter:drop-shadow(0 0 1px rgba(0,0,0,.95)) drop-shadow(0 0 3px rgba(0,0,0,.55))}
#cx svg.a,#cx svg.k{left:-6px;top:-5px}
#cx:not([data-s]) .a,#cx[data-s=arrow] .a,#cx[data-s=hand] .a,#cx[data-s=click] .k,#cx[data-s=text] .t,#cx[data-s=load] .l,#cx[data-s=no] .n{display:block}
#cx .a{transform-origin:6px 5px;transition:transform .18s var(--e),fill .18s}#cx[data-s=hand] .a{fill:#fff;transform:scale(1.1)}
#cx .sp{transform-origin:12px 12px;animation:cspin .8s steps(8) infinite}@keyframes cspin{to{transform:rotate(360deg)}}
/* glass buttons: magnet vars + pointer highlight + press */
.btn{position:relative;overflow:hidden;transform:translate(var(--tx,0px),var(--ty,0px)) scale(var(--sc,1));transition:transform .2s var(--e),box-shadow .2s,background .2s,filter .2s,opacity .2s}
.btn:active:not(:disabled):not([aria-disabled=true]){--sc:.97}.btn:hover{filter:brightness(1.12)}
.btn::after{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(110px circle at var(--mx,50%) var(--my,50%),rgba(255,255,255,.3),transparent 62%);opacity:0;transition:opacity .2s}.btn:hover::after{opacity:1}
.btn:disabled,.btn[aria-disabled=true]{opacity:.4;filter:none}.btn[aria-busy=true]{opacity:.7}
.win{position:relative}.win::after{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;background:radial-gradient(420px circle at var(--mx,50%) var(--my,50%),rgba(255,255,255,.075),transparent 45%);opacity:0;transition:opacity .3s}.win:hover::after{opacity:1}
#proj .win{transform:perspective(900px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg)) translateY(var(--lift,0px));transition:transform .3s var(--e),box-shadow .3s}#proj .win:hover{--lift:-4px}
#proj .win,#proj .win:hover{will-change:auto}
#proj.re .win{animation:fi .45s backwards}
.crow{display:flex;justify-content:space-between;align-items:center;color:var(--g7)}.crow .badge::after{content:"";display:inline-block;width:6px;height:6px;border-radius:50%;background:currentColor;margin-left:8px}
.hero{position:relative;isolation:isolate}.hero::before{content:"";position:absolute;left:50%;width:100vw;margin-left:-50vw;top:-40px;bottom:-40px;z-index:-1;pointer-events:none;background:radial-gradient(620px circle at var(--hx,72%) var(--hy,40%),rgba(255,255,255,.07),transparent 58%)}
.cue{position:absolute;left:-6px;bottom:30px;writing-mode:vertical-rl;transform:rotate(180deg);font:10px 'JetBrains Mono',monospace;letter-spacing:.2em;text-transform:uppercase;color:var(--g7);text-decoration:none}
.cue::after{content:"";display:inline-block;width:1px;height:46px;background:var(--line);margin-top:12px}@media(max-width:820px){.cue{display:none}}
/* typography */
h1.big{font-family:'Instrument Serif','Times New Roman',serif;font-weight:400;letter-spacing:-.025em;font-size:clamp(64px,10.5vw,132px);line-height:.98;background:none;color:var(--fg);animation:none}
.w{display:inline-block;overflow:hidden;vertical-align:bottom;padding:0 .04em .32em;margin:0 -.04em -.32em}.w>i{display:inline-block;font-style:normal}
h1.big .w>i{background:linear-gradient(180deg,var(--fg) 45%,var(--g7));-webkit-background-clip:text;background-clip:text;color:transparent}
.js .w>i{transform:translateY(112%)}.sp.in .w>i,.ready .hero-t .w>i{transform:none;transition:transform .95s var(--e);transition-delay:calc(var(--i)*85ms + 120ms)}
.ready .hero-t .w>i{transition-delay:calc(var(--i)*110ms + 350ms)}
h2.t::after{content:"";display:block;height:1px;margin-top:16px;background:var(--line);transform:scaleX(0);transform-origin:left;transition:transform 1.1s var(--e) .35s}h2.t.in::after{transform:none}
