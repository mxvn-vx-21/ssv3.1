.link{color:var(--fg);text-decoration:underline;text-underline-offset:5px}
#stage::before{content:"";position:absolute;inset:6%;border-radius:50%;background:radial-gradient(circle,rgba(190,205,235,.09),transparent 66%);pointer-events:none}#stage{position:relative;height:min(70vh,560px);min-height:340px}#stage canvas{width:100%!important;height:100%!important;display:block}
#fb{display:none;position:absolute;inset:0;place-items:center;font-size:min(46vw,320px);font-weight:700;color:var(--fg);text-shadow:0 0 40px rgba(155,184,255,.5);opacity:.9}
